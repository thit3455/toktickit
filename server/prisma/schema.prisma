generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

enum RequestedPriority {
  LOW
  MEDIUM
  HIGH
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

enum ActionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ActionOperation {
  CREATE
  EDIT
  ASSIGN
  STATUS
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  isActive  Boolean  @default(true)

  tickets Ticket[]

  @@index([isActive])
}

model User {
  id                 Int      @id @default(autoincrement())
  name               String
  email              String   @unique
  passwordHash       String
  role               UserRole
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sessions Session[]

  requestedTickets Ticket[] @relation("RequestedTickets")
  assignedTickets  Ticket[] @relation("AssignedTickets")

  comments      TicketComment[]
  internalNotes TicketInternalNote[]

  createdActions  ActionTaken[] @relation("ActionCreator")
  assignedActions ActionTaken[] @relation("ActionAssignee")
  performedActions ActionTaken[] @relation("ActionPerformer")
  actionRevisions ActionTakenRevision[]
  actionRequests ActionCreateRequest[]
  ticketStatusEvents TicketStatusEvent[]

  @@index([isActive])
  @@index([role])
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]

  @@index([isActive])
}

model Ticket {
  id                Int               @id @default(autoincrement())
  ticketNumber      String            @unique
  requesterId       Int
  assignedStaffId   Int?
  categoryId        Int
  relatedSystemId   Int
  summary           String
  description       String
  requestedPriority RequestedPriority
  itPriority        TicketPriority    @default(MEDIUM)
  currentStatus     TicketStatus      @default(NEW)
  requesterResolvedAt DateTime?
  version           Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  requester     User          @relation("RequestedTickets", fields: [requesterId], references: [id])
  assignedStaff User?         @relation("AssignedTickets", fields: [assignedStaffId], references: [id])
  category      Category      @relation(fields: [categoryId], references: [id])
  relatedSystem RelatedSystem @relation(fields: [relatedSystemId], references: [id])

  attachments   Attachment[]
  comments      TicketComment[]
  internalNotes TicketInternalNote[]

  actions ActionTaken[]
  actionRequests ActionCreateRequest[]
  statusEvents TicketStatusEvent[]

  @@index([requesterId])
  @@index([assignedStaffId])
  @@index([categoryId])
  @@index([relatedSystemId])
  @@index([currentStatus])
  @@index([createdAt])
  @@index([updatedAt])
}

model Attachment {
  id            Int       @id @default(autoincrement())
  ticketId      Int
  fileName      String
  mimeType      String
  fileSize      Int
  content       Bytes
  isRemoved     Boolean   @default(false)
  uploadedAt    DateTime  @default(now())
  removedAt     DateTime?
  removalReason String?

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([isRemoved])
}

model TicketComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  userId    Int
  message   String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([ticketId])
  @@index([userId])
}

model TicketInternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  userId    Int
  message   String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([ticketId])
  @@index([userId])
}

model Session {
  id        Int      @id @default(autoincrement())
  sessionId String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
}

model ActionTaken {
  id                 Int @id @default(autoincrement())
  ticketId           Int
  createdById        Int
  assignedToId       Int
  performedById      Int?
  description        String
  result             String @default("")
  followUpRequired   Boolean @default(false)
  followUpNote       String @default("")
  attachmentNotes    String @default("")
  status             ActionStatus @default(PLANNED)
  version            Int @default(1)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
  completedAt        DateTime? @db.Timestamptz(3)
  cancelledAt        DateTime? @db.Timestamptz(3)
  cancellationReason String?

  ticket      Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  createdBy   User @relation("ActionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo  User @relation("ActionAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  performedBy User? @relation("ActionPerformer", fields: [performedById], references: [id], onDelete: Restrict)
  revisions   ActionTakenRevision[]
  createRequest ActionCreateRequest?

  @@index([ticketId, createdAt, id])
  @@index([assignedToId, status, updatedAt, id])
  @@index([ticketId, status])
}

model ActionTakenRevision {
  id        Int @id @default(autoincrement())
  actionId  Int
  version   Int
  operation ActionOperation
  actorId   Int
  actorName String
  actorRole UserRole
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  snapshot  Json

  action ActionTaken @relation(fields: [actionId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([actionId, version])
  @@index([actorId])
}

model ActionCreateRequest {
  id        Int @id @default(autoincrement())
  actorId   Int
  ticketId  Int
  requestId String @db.Uuid
  actionId  Int @unique
  payload   Json
  response  Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  action ActionTaken @relation(fields: [actionId], references: [id], onDelete: Restrict)

  @@unique([actorId, ticketId, requestId])
  @@index([ticketId])
}

// Storage dependency only: Ticket workflow writes/history endpoint belong to I4.
model TicketStatusEvent {
  id         Int @id @default(autoincrement())
  ticketId   Int
  fromStatus TicketStatus
  toStatus   TicketStatus
  actorId    Int
  actorName  String
  actorRole  UserRole
  reason     String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt, id])
  @@index([ticketId, toStatus, createdAt])
  @@index([actorId])
}
